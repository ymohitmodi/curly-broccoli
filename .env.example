# Copy to .env and fill in what you have. Everything is optional to start —
# the harness runs fully offline on sample data until you wire real sources.

# --- LLM ---
# "ollama" (default) talks to your local Ollama daemon, which serves both
# local models and Ollama Cloud models (after `ollama signin`).
# "mock" runs the whole pipeline with deterministic fake output (for testing).
DARKFACTORY_LLM=ollama
OLLAMA_HOST=http://localhost:11434

# --- Amazon SP-API (free for registered sellers; enables real data) ---
SPAPI_REFRESH_TOKEN=
SPAPI_LWA_CLIENT_ID=
SPAPI_LWA_CLIENT_SECRET=
SPAPI_MARKETPLACE=ATVPDKIKX0DER   # US

# --- Amazon Ads API (for real PPC data) ---
ADS_API_CLIENT_ID=
ADS_API_CLIENT_SECRET=
ADS_API_REFRESH_TOKEN=
